<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="OFF">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss.SSS}] %-5level %msg%n"/>
        </Console>
        <RollingFile name="TestFile"
                     fileName="target/test-logs/Automation.log"
                     filePattern="target/test-logs/automation-%i.log.gz">
            <PatternLayout pattern="%msg%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="1 MB"/>
            </Policies>
        </RollingFile>
    </Appenders>
    <Loggers>
        <!-- Each Smart logger has exactly one destination in this test config. -->
        <Logger name="smart.console" level="TRACE" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="smart.file" level="TRACE" additivity="false">
            <AppenderRef ref="TestFile"/>
        </Logger>
        <Root level="OFF"/>
    </Loggers>
</Configuration>
